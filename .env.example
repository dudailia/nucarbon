# ── NUCarbon environment variables ───────────────────────────────────────────
# Copy to .env.local and fill in your own value. Never commit .env.local.
#   cp .env.example .env.local

# Anthropic API key — powers the three AI routes:
#   /api/research-assistant   (research page Q&A)
#   /api/generate-report      (simulator scenario write-up)
#   /api/executive-summary    (executive briefing page)
# Get one at https://console.anthropic.com/settings/keys
# Without it the site still builds and every chart renders; only the three
# AI surfaces above fail.
ANTHROPIC_API_KEY=sk-ant-...
